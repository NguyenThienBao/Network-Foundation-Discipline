// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Required for pgvector
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Enables AI Face Embeddings
}

// --- ENUMS ---

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum FeeType {
  FIXED_RATE
  SPLIT_TOTAL
}

// Updated based on the pure ledger architecture
enum EntryType {
  IN      // Money entering the system (Payments/Credits)
  DEBT    // Money owed by the player (Charges)
}

// Specific to 'IN' entries
enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum AuditStatus {
  VERIFIED
  FLAGGED_DISCREPANCY
  MANUAL_REVIEW_REQUIRED
}

enum AttendanceMethod {
  MANUAL
  FACE_ID
  NOTE_GENERATED
}

// --- MODELS ---

model Player {
  id                  String   @id @default(uuid()) @db.Uuid
  auth_id             String?  // For future NextAuth/Supabase login
  name                String
  fullname            String
  team                String?
  email               String   @unique
  phone               String?
  is_active           Boolean  @default(true)
  joinDate            DateTime @default(now())
  unique_payment_code String   @unique
  currentBalance      Decimal  @default(0.00) @db.Decimal(10, 2)
  
  // JSONB for multiple bank name variations
  known_bank_names    Json?    
  
  // Vector array for Face Recognition
  face_embedding      Unsupported("vector(512)")? 
  is_face_registered  Boolean  @default(false)
  face_updated_at     DateTime?

  // Relations
  attendances         Attendance[]
  ledgerEntries       LedgerEntry[]

  @@map("players")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  date            DateTime
  status          EventStatus @default(DRAFT)
  feeType         FeeType
  per_person_fee  Decimal?    @db.Decimal(10, 2)
  total_cost      Decimal?    @db.Decimal(10, 2)
  textNote        String?
  created_at      DateTime    @default(now())

  // Relations
  roster          Attendance[]
  ledgerEntries   LedgerEntry[] // Only populated when Event generates DEBTs

  @@map("events")
}

model Attendance {
  id              String            @id @default(uuid()) @db.Uuid
  eventId         String            @db.Uuid
  playerId        String            @db.Uuid
  isTicked        Boolean           @default(false)
  calculatedFee   Decimal           @default(0.00) @db.Decimal(10, 2)
  check_in_time   DateTime?
  method          AttendanceMethod?

  // Relations
  event           Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player          Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // A player can only have one attendance record per event
  @@unique([eventId, playerId])
  @@map("attendance")
}

model LedgerEntry {
  id              String         @id @default(uuid()) @db.Uuid
  playerId        String         @db.Uuid
  eventId         String?        @db.Uuid // Filled ONLY if DEBT is auto-generated by an Event
  amount          Decimal        @db.Decimal(10, 2)
  type            EntryType      // IN or DEBT
  payment_method  PaymentMethod? // Filled ONLY if type is IN
  created_at      DateTime       @default(now())

  // Relations
  player          Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event           Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  
  manualAdjustment  ManualAdjustment? // Filled ONLY if DEBT is manually created
  auditLog          AuditTransactionLog? // Filled ONLY if IN is via Agentic OCR

  @@map("ledger_entries")
  @@index([playerId, created_at])
}

model ManualAdjustment {
  id              String   @id @default(uuid()) @db.Uuid
  ledgerEntryId   String   @unique @db.Uuid // 1-to-1 relation to the specific DEBT entry
  explanation     String   // Mandatory explanation note
  adjusted_by     String   // Admin auth ID who created the manual debt
  created_at      DateTime @default(now())

  // Relations
  ledgerEntry     LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@map("manual_adjustments")
}

model AuditTransactionLog {
  id                  String      @id @default(uuid()) @db.Uuid
  ledger_entry_id     String      @unique @db.Uuid // 1-to-1 relation to the specific IN entry
  bank_reference_num  String      @unique
  extracted_amount    Decimal     @db.Decimal(10, 2)
  confidence_score    Decimal     @db.Decimal(3, 2) // e.g. 0.95
  audit_status        AuditStatus
  raw_ocr_text        Json
  created_at          DateTime    @default(now())

  // Relations
  ledgerEntry         LedgerEntry @relation(fields: [ledger_entry_id], references: [id], onDelete: Cascade)

  @@map("audit_transaction_logs")
}